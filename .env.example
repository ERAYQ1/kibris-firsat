# Uygulama ortamı: development | production
NODE_ENV=development

# SQLite veritabanı dosya yolu (git'e girmez)
DATABASE_PATH=./data/app.db

# Yüklenen görsellerin saklanacağı dizin (git'e girmez)
UPLOAD_DIR=./data/uploads

# Bu e-posta adresleriyle kayıt olan kullanıcılar otomatik admin olur.
# Virgülle ayrılmış liste. Production'da mutlaka doldurun.
ADMIN_EMAILS=

# Public URL (cookie secure flag ve origin doğrulaması için production'da gerekli)
APP_URL=http://localhost:3000
